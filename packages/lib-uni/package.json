  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/hairylib.git"
  },
  "bugs": "https://github.com/hairyf/hairylib/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
